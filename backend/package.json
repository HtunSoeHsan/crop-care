{
  "name": "plant-disease-api",
  "version": "1.0.0",
  "description": "Plant disease detection and prevention API",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "build": "tsc",

    "train": "ts-node src/scripts/train_model.ts",
    "prepare-dataset": "ts-node src/scripts/prepare_dataset.ts",
    "setup-llm": "chmod +x setup-llm.sh && ./setup-llm.sh",
    "test-llm": "node test-llm.js",
    "seed": "ts-node src/seeders/index.ts"
  },
  "keywords": [
    "plant",
    "disease",
    "detection",
    "machine-learning",
    "tensorflow",
    "llm",
    "chatbot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.10.0",
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^8.17.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.32.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"

}
}
